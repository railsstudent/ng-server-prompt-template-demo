{
  "name": "ng-server-prompt-template-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config": "node scripts/generate-firebase-config.js",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "firebase:remoteconfig": "node scripts/download-remote-config.js",
    "lintstaged": "lint-staged"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.11",
    "@angular/compiler": "21.2.11",
    "@angular/core": "21.2.11",
    "@angular/forms": "21.2.11",
    "@angular/platform-browser": "21.2.11",
    "@angular/router": "21.2.11",
    "@tailwindcss/postcss": "4.2.4",
    "firebase": "12.12.1",
    "postcss": "8.5.14",
    "rxjs": "~7.8.0",
    "tailwindcss": "4.2.4",
    "tslib": "^2.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.9",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.11",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-angular": "20.5.3",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.3.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "firebase-tools": "15.17.0",
    "husky": "9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.3",
    "prettier": "3.8.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1"
  }
}

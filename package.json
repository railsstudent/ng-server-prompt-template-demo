{
  "name": "ng-server-prompt-template-demo",
  "version": "0.0.0",
  "author": "Connie Leung <cleung334@gmail.com>",
  "scripts": {
    "ng": "ng",
    "config": "node firebase/scripts/generate-firebase-config.js",
    "firebase:remoteconfig": "node firebase/scripts/download-remote-config.js",
    "create-cities-json": "node firebase/scripts/generate-city-country-pairs.js",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lintstaged": "lint-staged"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.2",
    "@angular/compiler": "22.0.2",
    "@angular/core": "22.0.2",
    "@angular/forms": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/router": "22.0.2",
    "@tailwindcss/postcss": "4.3.1",
    "firebase": "12.15.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "4.3.1",
    "tslib": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "22.0.3",
    "@angular/compiler-cli": "22.0.2",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-angular": "21.0.2",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "firebase-tools": "15.22.0",
    "husky": "9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "17.0.8",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1"
  }
}
